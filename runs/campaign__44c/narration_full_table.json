   "end_ms": 81053,
   "fits_window": true,
   "cache_hit": true,
   "trace_id": "070d63333f9fae45d2e1e69e671930af"
  },
  {
   "cue_id": "nd13",
   "shot_id": "s03_c04",
   "text": "光束扫过河面，灯亮了，晚归的船，就认得回家的路。",
   "version_id": "nver_c90c8f91",
