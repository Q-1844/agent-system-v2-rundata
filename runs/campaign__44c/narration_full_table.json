 "cues": [
  {
   "cue_id": "nd01",
   "shot_id": "s01_c01",
   "text": "暴雨过后的河面，总会留下一些东西，等着被谁捡起。",
   "version_id": "nver_89bad82f",
   "voice_id": "Chinese (Mandarin)_Gentleman",
   "speed": 0.9,
   "file": "audio_imports/narration/nd01__nver_89bad82f.wav",
   "sha256": "b4cd43c7450152c39c8b2c87ddf5173c7d940534e1bccd043966b8e2e4605753",
   "duration_ms": 4737,
   "window_ms": [
    0,
    8000
   ],
